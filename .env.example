# Copy to .env and fill in. Every value is optional: with no keys the app falls back to
# regex extraction, template drafts, no tracing and disabled email transport.

# --- Gemini (LLM extraction + drafting) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Langfuse tracing (leave blank to disable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Server ---
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database / checkpointing ---
# Tests and local dev can use CHECKPOINTER_BACKEND=memory; use postgres for durable negotiations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbitrage_desk
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_ALLOW_VOLATILE_FALLBACK=false

# --- Email (the desk's own mailbox) ---
EMAIL_USER=
EMAIL_PASS=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
EMAIL_POLL_INTERVAL_SECONDS=15

# Inbound ingestion: true = Gmail Pub/Sub push, false = IMAP polling
USE_PUSH_WEBHOOKS=false
GOOGLE_PUBSUB_TOPIC=
# Headless Gmail API auth. Generate the refresh token once with: python scripts/gmail_auth.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Live email testing (three different inboxes: desk, buyer, supplier) ---
MY_TEST_EMAIL=
MY_TEST_SUPPLIER_EMAIL=
# Demo only: fabricate a supplier quote instead of waiting for a real one
SIMULATE_SUPPLIER=false

# --- Desk identity ---
DESK_NAME=Global Agro Arbitrage Desk
DESK_EMAIL=desk@arbitrage.com

# --- Deal defaults ---
DEFAULT_COMMODITY=Basmati 1121
DEFAULT_TARGET_VOLUME_MT=500
DEFAULT_TARGET_MARGIN_PCT=10
DEFAULT_MAX_VARIANCE_PCT=5
DEFAULT_BUFFER_USD_PER_MT=20
DEFAULT_ORIGIN_PORT=Karachi
DEFAULT_DESTINATION_PORT=Jebel Ali
DEFAULT_PAYMENT_TERMS=100% LC at sight
DEFAULT_MAX_NEGOTIATION_ROUNDS=3
