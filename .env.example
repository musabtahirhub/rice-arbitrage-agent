# ===========================================================================
# Commodity Arbitrage Multi-Agent System - Centralized Environment Config
# All dynamic business parameters, AI models, URLs, and server ports are
# configured here so that Python code never needs manual edits.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. AI & LLM Model Configuration
# ---------------------------------------------------------------------------
# Google Gemini API key for intelligent email extraction & drafting
# (Leave blank to use the built-in deterministic regex fallback engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (e.g., gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Generation temperature for trade drafting (0.0 = strict deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Email Transport Configuration (Live Gmail Integration)
# ---------------------------------------------------------------------------
# Gmail SMTP & IMAP credentials (use an App Password if 2FA is enabled)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
MY_TEST_EMAIL=recipient_email@domain.com

# ---------------------------------------------------------------------------
# 2. Server & Networking
# ---------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# 3. Live Market Data Scraper & Freight Estimator
# ---------------------------------------------------------------------------
# Public market board URL for live FOB benchmark price ingestion (Yahoo Finance Rough Rice ZR=F)
MARKET_SOURCE_URL=https://query1.finance.yahoo.com/v8/finance/chart/ZR=F?interval=1d&range=5d

# Local JSON cache file for market feeds
MARKET_CACHE_FILE=market_cache.json

# Cache Time-To-Live in seconds (21600 = 6 hours)
MARKET_DATA_CACHE_TTL_SECONDS=21600

# HTTP request timeout in seconds for scraping
MARKET_FETCH_TIMEOUT_SECONDS=3.5

# Fallback baseline FOB rate (USD/MT) if external board is offline
DEFAULT_BENCHMARK_RATE=900.0

# Baseline ocean container freight rate (USD/MT)
DEFAULT_FREIGHT_RATE=50.0

# Default bunker/fuel surcharge adjustment factor (BAF %)
DEFAULT_FUEL_SURCHARGE_PCT=0.0

# ---------------------------------------------------------------------------
# 4. Default Campaign Arbitrage Parameters
# ---------------------------------------------------------------------------
DEFAULT_COMMODITY=Basmati 1121
DEFAULT_TARGET_VOLUME_MT=500.0
DEFAULT_TARGET_MARGIN_PCT=10.0
DEFAULT_MAX_VARIANCE_PCT=5.0
DEFAULT_BUFFER_USD_PER_MT=20.0
DEFAULT_DESTINATION_PORT=Jebel Ali
DEFAULT_ORIGIN_PORT=Karachi
DEFAULT_PAYMENT_TERMS=100% LC at sight
DEFAULT_BROKEN_PERCENTAGE=5.0

# ---------------------------------------------------------------------------
# 5. Trading Desk Identity & Sign-Off
# ---------------------------------------------------------------------------
DESK_NAME=Global Agro Arbitrage Desk
DESK_EMAIL=trading@arbitrage-desk.com
