# ===========================================================================
# Rice Arbitrage Multi-Agent System - Environment Configuration
# ===========================================================================

# Google Gemini API key for intelligent email extraction & drafting
# (If blank, the system automatically runs in offline regex-fallback mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Server settings
PORT=8000
HOST=127.0.0.1

# Default Arbitrage Campaign Parameters
DEFAULT_TARGET_MARGIN_PCT=10.0
DEFAULT_MAX_VARIANCE_PCT=5.0
DEFAULT_BUFFER_USD_PER_MT=20.0
