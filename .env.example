# === API Keys & AI Configuration ===
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# === Email Integration (Gmail SMTP/IMAP) ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
MY_TEST_EMAIL=test@example.com

# === Google Cloud Pub/Sub Webhooks ===
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/your-topic
GOOGLE_CREDENTIALS_JSON_PATH=credentials.json
GOOGLE_TOKEN_JSON_PATH=token.json
USE_PUSH_WEBHOOKS=True

# === Application Server Configuration ===
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS="*"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbitrage_desk

# === Market Data Configuration ===
MARKET_SOURCE_URL=https://query1.finance.yahoo.com/v8/finance/chart/ZR=F?interval=1d&range=5d
MARKET_CACHE_FILE=market_cache.json
MARKET_CACHE_TTL_SECONDS=21600
MARKET_FETCH_TIMEOUT_SECONDS=3.5
DEFAULT_BENCHMARK_RATE=900.0
DEFAULT_FREIGHT_RATE=50.0
DEFAULT_FUEL_SURCHARGE_PCT=0.0

# === Trade Campaign Defaults ===
DEFAULT_COMMODITY=Basmati 1121
DEFAULT_TARGET_VOLUME_MT=500.0
DEFAULT_TARGET_MARGIN_PCT=10.0
DEFAULT_MAX_VARIANCE_PCT=5.0
DEFAULT_BUFFER_USD_PER_MT=20.0
DEFAULT_DESTINATION_PORT=Jebel Ali
DEFAULT_ORIGIN_PORT=Karachi
DEFAULT_PAYMENT_TERMS=100% LC at sight
DEFAULT_BROKEN_PERCENTAGE=5.0

# === Trading Desk Identity ===
DESK_NAME=Global Agro Arbitrage Desk
DESK_EMAIL=musabtahir2@gmail.com
