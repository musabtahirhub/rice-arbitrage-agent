# ===========================================================================
# Rice Arbitrage Multi-Agent System - Environment Configuration
# ===========================================================================

# --- LLM Authentication ---
# Google Gemini API key for email extraction and SCO drafting
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email Provider Settings ---
# Options: "mock" (logs to stdout/file), "smtp" (standard SMTP), "resend" (Resend API)
EMAIL_PROVIDER=mock

# Resend API Key (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_1234567890abcdef

# SMTP Credentials (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trading@mydomain.com
SMTP_PASSWORD=app_specific_password_here

# --- Operator Notifications ---
# Webhook URL for human operator deal authorization alerts (Slack, Discord, Telegram, or custom webhook)
OPERATOR_NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/T00/B00/XXXX

# --- Market Data Cache ---
# Cache TTL in seconds before triggering live re-scrapes (default: 21600 = 6 hours)
MARKET_DATA_CACHE_TTL_SECONDS=21600

# --- Server & CORS Runtime ---
DEFAULT_APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
